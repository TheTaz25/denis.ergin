    <p>
      Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV:
      <br>
      Denis Ergin <br>
      Albgaustraße 3a <br>
      76337 Waldbronn
    </p>
    
  </section>
</Layout>

<style scoped>
.inset {
  margin: 2rem auto;
