---
import { getCollection } from "astro:content";
import Layout, { type NavigationItem } from "../../layouts/Layout.astro";
import LectureSection from "../../components/molecules/lecture-section/index.astro";
import type { SeoProps } from "../../components/special/seo.astro";

const dhbwModules = await getCollection('dhbw');

const backlinks: Array<NavigationItem> = [{
  name: 'Startseite',
  to: '/',
}, {
  name: 'Kursinhalte DHBW',
  to: '/knowledge-base'
}]

const seo: SeoProps = {
  description: "Startseite zu allen Online-Slides für den DHBW-Kurs 'Web Engineering'.",
  title: 'Kursinhalte DHBW'
}
---

<Layout seoProps={seo} backlinks={backlinks}>
  <article class="lectures">
    <h1 class="heading-large">Kursinhalte DHBW</h1>
    {dhbwModules.map(module => (
      <LectureSection module={module.data} />
    ))}
  </article>
</Layout>

<style scoped lang="scss">
.lectures {
  padding: 0 2rem;
  max-width: 1200px;
  margin: 0 auto;
}
</style>