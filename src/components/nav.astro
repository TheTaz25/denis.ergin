---
interface NavigationItem {
	to: string;
	name: string;
}

interface Props {
  data: Array<NavigationItem>
}

const { data } = Astro.props;
---

<nav class="breadcrumb">
  <ul>
    {data.map((item, i) => (
      <li>
        { i + 1 === data.length ? (
          <span>
            {item.name}
          </span>
        ) : (
          <a href={item.to}>
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>

<style lang="scss">
.breadcrumb {
  margin: 0rem 2rem;

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 2rem;

    li:not(:last-of-type):after {
      padding-inline-start: 2rem;
      content: '>'
    }
  }

  a, span {
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  a {
    transition: color 150ms ease-in-out;
  }
  a:hover {
    color: var(--button-background-color);
  }
}
</style>