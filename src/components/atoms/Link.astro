---
interface Props {
  to: string;
	variant?: 'vibrant';
}

const { to, variant } = Astro.props;

const className = [];
if (variant === 'vibrant') {
	className.push('as-button');
}
---

<a href={to} class={className.join(' ')}>
  <slot />
</a>

<style lang="scss">
a {
	text-decoration: none;
	color: white;
	font-size: large;
	position: relative;
	padding: 1rem .75rem;
	border-radius: 4px;
	display: inline-block;

	&.as-button {
		background: var(--button-background-color);
	}
}
</style>