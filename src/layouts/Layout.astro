---
import Navigation from '../components/nav.astro'
import Seo from '../components/special/seo.astro';
import Footer from '../components/footer.astro'
import { getLangFromUrl } from '../i18n/utils';
import '../styles/global.scss'
import type { SeoProps } from '../components/special/seo.astro';

export interface NavigationItem {
	to: string;
	name: string;
}

interface Props {
	backlinks?: Array<NavigationItem>,
	seoProps: SeoProps,
}

const { seoProps, backlinks } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/AllertaStencil-Reg.ttf" as="font" />
		<link rel="preload" href="/fonts/Quicksand-Var.ttf" as="font" />
		<Seo seo={seoProps} />
	</head>
	<body>
		{ backlinks && (
			<header>
				<Navigation data={backlinks} />
			</header>
		)}
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
<style is:global lang="scss">
	html, a:visited {
		font-family: system-ui, sans-serif;
		background-color: var(--background-color);
		color: var(--foreground-color);
	}
	body {
		margin: 0;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	header {
		margin: 1rem 1rem;
	}
</style>
